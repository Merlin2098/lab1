# Plantilla de credenciales del laboratorio.
# 1. Copia este archivo:   cp .env.credentials.example .env.credentials
# 2. Pega tus claves en .env.credentials (sin comillas y sin espacios junto al =).
# 3. Cárgalas en la terminal:   set -a; source .env.credentials; set +a
#
# .env.credentials está en .gitignore: NUNCA lo subas, lo compartas ni lo muestres.
AWS_ACCESS_KEY_ID=PEGA_AQUI_TU_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=PEGA_AQUI_TU_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1
